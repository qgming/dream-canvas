**/dist
**/data
**/coverage
**/.git
**/.env
**/.env.*
**/*.log
**/*.tsbuildinfo
**/*.sqlite*
**/*.db
**/*.db-*
**/*.key
**/*.pem
**/*.p12
**/.DS_Store
web/public/plugins
