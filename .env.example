# Docker Compose settings only; channel and storage credentials belong in the app.
COMPOSE_PROJECT_NAME=dream-canvas

# Published stable release (vX.Y.Z), latest stable (latest), or development (main).
# A specific commit is available as sha-<full commit SHA> after its workflow succeeds.
# Ignored when using compose.build.yaml.
DREAM_CANVAS_TAG=latest

# Local HTTP access. Use HTTPS for remote access.
DREAM_CANVAS_BIND=127.0.0.1
DREAM_CANVAS_PORT=8080
TZ=UTC

# Optional: Go runtime memory limit and GC target for small-memory hosts.
GOMEMLIMIT=650MiB
GOGC=75

# Optional: extra trusted proxy IPs/CIDRs, comma-separated. Default: loopback only.
# For a host reverse proxy, inspect the actual Docker bridge gateway and trust
# only that address, e.g. 172.18.0.1/32. Never trust the entire Docker network.
DREAM_CANVAS_TRUSTED_PROXIES=

# Required only when enabling compose.https.yaml. Use a hostname, without https://.
DOMAIN=
